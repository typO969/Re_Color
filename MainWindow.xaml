<Window
   x:Class="Re_Color.MainWindow"
   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
   Title="Re_Color"
   Width="1280"
   Height="760"
   Background="#161616"
   Foreground="#E8E8E8"
   mc:Ignorable="d">
   <Grid Margin="12">
      <Grid.RowDefinitions>
         <RowDefinition Height="Auto" />
         <RowDefinition Height="Auto" />
         <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <DockPanel Margin="0,0,0,10">
         <TextBlock FontSize="20" FontWeight="SemiBold" Text="Re_Color" Width="114" FontFamily="Helvetica LT Std Black" />
         <TextBlock Margin="14,4,0,0" Foreground="#A2A2A2" Text="Ctrl+Alt+C to sample, click swatch to copy" Width="231" />
            <Button x:Name="butSample" HorizontalAlignment="Right" Width="100" Content="🧪 Re__Pick" MinWidth="50" MinHeight="22" UseLayoutRounding="False" FontSize="14" FontWeight="Bold"/>
        </DockPanel>

      <Border
         Grid.Row="1"
         Padding="8"
         Background="#222"
         BorderBrush="#333"
         BorderThickness="1"
         CornerRadius="8">
         <ItemsControl x:Name="RecentColorsBar">
            <ItemsControl.ItemsPanel>
               <ItemsPanelTemplate>
                  <WrapPanel />
               </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
         </ItemsControl>
      </Border>

      <Grid Grid.Row="2" Margin="0,12,0,0">
         <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftPaneColumn" Width="330" MinWidth="240" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition x:Name="RightPaneColumn" Width="*" MinWidth="420" />
         </Grid.ColumnDefinitions>

         <Border Grid.Column="0" Padding="10" Background="#1E1E1E" BorderBrush="#353535" BorderThickness="1" CornerRadius="8">
            <DockPanel>
               <StackPanel x:Name="spProjControl" DockPanel.Dock="Top" Margin="0,0,0,8" Orientation="Horizontal">
                  <Button Width="90" Margin="0,0,8,0" Click="AddProject_Click" Content="New Project" />
                  <Button Width="110" Margin="0,0,8,0" Click="RemoveProject_Click" Content="Remove Project" />
                  <ComboBox x:Name="SortCombo" Width="140" SelectionChanged="SortCombo_SelectionChanged">
                     <ComboBoxItem IsSelected="True" Content="Sort: Date" />
                     <ComboBoxItem Content="Sort: Name" />
                  </ComboBox>
                  <Button Width="70" Margin="8,0,0,0" Click="ImportProjects_Click" Content="Import" />
                  <Button Width="70" Margin="8,0,0,0" Click="ExportProjects_Click" Content="Export" />
                  <Button Width="100" Margin="8,0,0,0" Click="ExportAse_Click" Content="Export ASE" />
               </StackPanel>
               <ListBox x:Name="ProjectsList" DisplayMemberPath="DisplayLine" SelectionChanged="ProjectsList_SelectionChanged" />
            </DockPanel>
         </Border>

         <GridSplitter
            Grid.Column="1"
            Width="6"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            ResizeBehavior="PreviousAndNext"
            ResizeDirection="Columns"
            Background="#2C2C2C"
            ShowsPreview="True"
            DragCompleted="ColumnSplitter_DragCompleted" />

         <Grid Grid.Column="2" Margin="12,0,0,0">
            <Grid.RowDefinitions>
               <RowDefinition Height="Auto" />
               <RowDefinition Height="Auto" />
               <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Padding="10" Background="#1E1E1E" BorderBrush="#353535" BorderThickness="1" CornerRadius="8">
               <StackPanel x:Name="spProjMD" Orientation="Horizontal">
                  <TextBlock VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Text="Project" />
                  <TextBox x:Name="ProjectNameBox" Width="280" Margin="8,0,0,0" TextChanged="ProjectMeta_Changed" />
                  <TextBlock Margin="18,0,0,0" VerticalAlignment="Center" Text="Started" />
                  <DatePicker x:Name="StartDatePicker" Width="140" Margin="6,0,0,0" SelectedDateChanged="ProjectMeta_Changed" />
                  <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="Due" />
                  <DatePicker x:Name="DueDatePicker" Width="140" Margin="6,0,0,0" SelectedDateChanged="ProjectMeta_Changed" />
                        <Button x:Name="butSave" Width="100" HorizontalAlignment="Right" Margin="35,0,0,0" MinWidth="80" MinHeight="24" Content="Save Project"></Button>
               </StackPanel>
            </Border>

            <UniformGrid x:Name="ugSlotItemsLabel" Grid.Row="1" Margin="0,10,0,8" Columns="5" VerticalAlignment="Bottom">
               <TextBlock HorizontalAlignment="Center" Text="Accent 1 (Light)" />
               <TextBlock HorizontalAlignment="Center" Text="Secondary (Links)" />
               <TextBlock HorizontalAlignment="Center" Text="Primary (Brand)" />
               <TextBlock HorizontalAlignment="Center" Text="Background (Optional)" />
               <TextBlock HorizontalAlignment="Center" Text="Accent 2 (Dark)" />
            </UniformGrid>

            <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
               <ItemsControl x:Name="SlotsItemsControl">
                  <ItemsControl.ItemsPanel>
                     <ItemsPanelTemplate>
                        <WrapPanel />
                     </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                     <DataTemplate>
                        <StackPanel MinWidth="180" MaxWidth="260" Margin="0,0,8,8">
                           <Border
                              Height="110"
                              Margin="1"
                              Background="{Binding EditableBrush}"
                              ToolTip="Right-click to Add/Remove; drag recent colors here"
                              Tag="{Binding Index}"
                              AllowDrop="True"
                              Loaded="EditableSwatch_Loaded"
                              Drop="Slot_Drop">
                              <TextBlock
                                 Margin="8,10,8,0"
                                 FontSize="21"
                                 FontWeight="Bold"
                                 Foreground="{Binding EditableTextBrush}"
                                 Text="{Binding EditableHex}" />
                           </Border>
                           <Border Height="110" Margin="1" Background="{Binding GrayBrush}" ToolTip="Calculated grayscale">
                              <TextBlock
                                 Margin="8,10,8,0"
                                 FontSize="21"
                                 FontWeight="Bold"
                                 Foreground="{Binding GrayTextBrush}"
                                 Text="{Binding GrayHex}" />
                           </Border>
                        </StackPanel>
                     </DataTemplate>
                  </ItemsControl.ItemTemplate>
               </ItemsControl>
            </ScrollViewer>
         </Grid>
      </Grid>
   </Grid>
</Window>
