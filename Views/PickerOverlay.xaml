<Window
   x:Class="Re_Color.Views.PickerOverlay"
   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
   Width="240"
   Height="107"
   Background="#222222"
   KeyDown="Window_KeyDown"
   ResizeMode="NoResize"
   ShowInTaskbar="False"
   Topmost="True"
   WindowStyle="None"
   AllowsTransparency="True">

   <Border Padding="12" CornerRadius="12" Background="#222222" UseLayoutRounding="False">
      <StackPanel>
         <TextBlock
            x:Name="HexText"
            FontSize="24"
            Foreground="White"
            Text="#------" />
            <TextBlock
            x:Name="RgbText"
            FontSize="14"
            Foreground="#CCCCCC"
            Text="rgb(-, -, -)" />

            <TextBlock
            x:Name="StatusText"
            Margin="0,10,0,0"
            FontSize="12"
            Foreground="#EEEEEE"
            Text="Click to copy HEX" />
      </StackPanel>
   </Border>
</Window>